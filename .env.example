# Vite 공개 환경변수 (클라이언트에 노출됨 — NCP에서 Web 서비스 URL 등록 필수)
# 네이버 클라우드 콘솔 → AI·NAVER API → Maps → Application → ncpKeyId
VITE_NAVER_MAP_NCP_KEY_ID=

# CI(GitHub Actions)에도 같은 값을 Secrets → VITE_NAVER_MAP_NCP_KEY_ID 로 넣어야 함.
# .env 는 gitignore 라 Actions 빌드에 자동으로 안 들어감. 빠지면 지도가 빈 키로 배포됨.

# Functions (Secret Manager / functions/.env) — Geocoding · Directions 용 Client ID/Secret
# NAVER_NCP_API_KEY_ID=
# NAVER_NCP_API_KEY=
